# ============================================================================
# SAMA CRM — environment variables
# Copy this file to .env.local and fill in the placeholders marked YOUR_*.
# Values already filled in are public (publishable) and safe to keep.
# ============================================================================

# --- Supabase (project: sama-crm / vsxesrhoovabgsmvodvh) --------------------
# Public URL + anon key are publishable values — already filled in.
NEXT_PUBLIC_SUPABASE_URL=https://vsxesrhoovabgsmvodvh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZzeGVzcmhvb3ZhYmdzbXZvZHZoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIzMTQzODksImV4cCI6MjA5Nzg5MDM4OX0.kxf8ywEdoUGtCuofVLgLAHPrguoyLafrn-JJEIMsnF4

# Service role key — Supabase Dashboard → Project Settings → API → service_role.
# SERVER ONLY. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- WhatsApp Cloud API (Meta) -----------------------------------------------
# Meta for Developers → your app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=YOUR_META_PERMANENT_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID
# You invent this value, then paste the SAME value in Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=YOUR_RANDOM_WEBHOOK_VERIFY_TOKEN
# Meta app secret — used to verify webhook signatures (App Settings → Basic).
WHATSAPP_APP_SECRET=YOUR_META_APP_SECRET
# Name of the pre-approved Meta template used for replies OUTSIDE the 24h window.
WHATSAPP_REENGAGE_TEMPLATE=YOUR_APPROVED_UTILITY_TEMPLATE_NAME

# --- Resend (email) ----------------------------------------------------------
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Must be a verified sender/domain in Resend.
EMAIL_FROM="Sama Hotel <noreply@YOUR_DOMAIN>"

# --- App ----------------------------------------------------------------------
# Public URL of the deployed app (no trailing slash).
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN
# Optional — link substituted into {{terms_link}} in marketing templates.
# Defaults to the built-in bilingual page at https://sama-crm.vercel.app/terms.
# TERMS_LINK=https://YOUR_DOMAIN/terms
# PIN staff enter to exit the /checkin kiosk (4-8 digits).
KIOSK_EXIT_PIN=YOUR_KIOSK_PIN
